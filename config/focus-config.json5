{
	"autoSwitchToThirdPerson": true,
	"allowFirstPersonWhileTargeting": true,
	"allowFrontFacingThirdPersonWhileTargeting": false,
	"showLockOnStatusMessages": false,
	"showLockOnDebugText": false,
	"experimentalPersistentWalkthroughBackwardsWalking": false,
	"cinematicBarsWhileLockedOn": false,
	"cinematicBarsUnderHud": true,
	"lockOnIndicatorStyle": "OOT_16X",
	"useCustomSwappedShoulderValues": false,
	"cameraMode": "DYNAMIC",
	"cameraBehavior": {
		"cameraFloatiness": 0.32,
		"cameraDrag": 0.88,
		"cameraStepSize": 0.025,
		"dynamicallyAdjustOffsets": true,
		"smoothCameraTransition": true,
		"cameraTransitionSpeed": 0.12
	},
	"cameraFollowing": {
		"followPlayerRotations": true,
		"followPlayerRotationsDelay": 0.0,
		"cameraHeadFollowResponsiveness": 0.45,
		"cameraBodyFollowResponsiveness": 0.25,
		"fullBodyFollowEnabled": true
	},
	"shoulderSwap": {
		"cameraSwapSpeed": 0.16,
		"dynamicCameraSwapSpeed": 0.12,
		"dynamicShoulderAutoSwapEnabled": true,
		"dynamicShoulderSwitchThreshold": 0.08,
		"dynamicShoulderVisibilityWeight": 0.7,
		"dynamicShoulderManualOverrideCooldownTicks": 30.0
	},
	"playerTransparency": {
		"adjustPlayerTransparency": true,
		"playerTransparencyMinAlpha": 0.25,
		"playerTransparencyFadeSpeed": 0.2,
		"playerTransparencyWhenTargetObscuredOnly": true,
		"playerTransparencyInPreview": false
	},
	"crosshair": {
		"crosshairCorrectionMode": "HYBRID",
		"renderCorrectedCrosshair": false,
		"correctBlockPlacementRay": true,
		"correctEntityHitRay": true,
		"correctCrosshairOnlyWhileLockedOn": false,
		"hideVanillaCrosshair": true,
		"hideVanillaCrosshairOutOfRange": false
	},
	"cameraSwapSmoothness": 0.9,
	"dynamicCameraSwapSmoothness": 0.12,
	"dynamicShoulderScreenPlacementWeight": 0.3,
	"selectedCameraProfile": "",
	"targetSwapMouseDeadzone": 12.0,
	"targetSwapMouseActivation": 21.0,
	"targetSwapDirectionThreshold": 0.56,
	"targetSwapMinScreenSeparation": 0.06,
	"targetSwapCooldownTicks": 8.0,
	"targetSwapSmoothTicks": 12.0,
	"targetSwapInputDecay": 0.82,
	"targetSwapLookYawResponsiveness": 2.8,
	"targetSwapLookPitchResponsiveness": 2.4,
	"targetSwapLookMaxYawStepPerTick": 3.8,
	"targetSwapLookMaxPitchStepPerTick": 2.8,
	"targetSwapTargetPointResponsiveness": 4.2,
	"targetSwapPlayerLookFollow": 0.3,
	"enableTargetFilters": false,
	"targetFilterMode": "EXCLUDE",
	"filterPlayers": true,
	"filterPassiveMobs": true,
	"filterNeutralMobs": false,
	"filterHostileMobs": false,
	"targetFilterEntityIds": []
}